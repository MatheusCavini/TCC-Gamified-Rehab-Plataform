# Copy this file to .env and fill only the integrations installed on this PC.
# .env is ignored by Git: never commit credentials or licence-specific commands.

# EEG Emotiv (required only when selecting EEG Emotiv in the Unity launcher)
EMOTIV_CLIENT_ID=
EMOTIV_CLIENT_SECRET=
# EMOTIV_PYTHON=C:\\Path\\To\\python.exe
EMOTIV_ENABLE_RAW_EEG=false

# EMG Noraxon (required only when selecting EMG Noraxon). Replace the example
# channel ID with the channel ID configured in Noraxon Acquire. The command must
# run in the Windows Python environment where noraxon_sdk is installed.
# NORAXON_SENDER_COMMAND=uv run --project ..\\repo_EMG_noraxon\\noraxon-sdk python src\\noraxon_emg\\scripts\\noraxon_tcp_sender.py --use-setup --channel-id "SEU_CHANNEL_ID" --host 127.0.0.1 --port 8765

# USB auto-identification. Defaults already cover the known guide handlebar and
# common pulmonary boards. Set a more precise case-insensitive regular expression
# only if two connected USB devices have an ambiguous description in `usbipd list`.
# REHAB_GUIDAO_USB_MATCH=Guidao|Guidão|Arduino.*(M0|Zero|Uno)
# REHAB_PULMONARY_USB_MATCH=Pulmonar|Respir|ESP32|CP210|CH340
