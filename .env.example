# Copy this file to .env and fill only the integrations installed on this PC.
# .env is ignored by Git: never commit credentials or machine-specific values.
#
# Values are read literally by scripts/Start-RehabSystem.ps1 AND by Docker
# Compose: there is no escape processing. Write Windows paths and IDs with
# SINGLE backslashes. Wrap values containing special characters in single quotes.

# EEG Emotiv (required only when selecting EEG Emotiv in the Unity launcher)
EMOTIV_CLIENT_ID=
EMOTIV_CLIENT_SECRET=
# Optional: full path when neither `py -3` nor `python` resolves the desired Python 3.
# EMOTIV_PYTHON=C:\Path\To\python.exe
EMOTIV_ENABLE_RAW_EEG=false

# EMG Noraxon (required only when selecting EMG Noraxon).
# The launcher builds the sender command itself (uv run --project <SDK> python
# src\noraxon_emg\scripts\noraxon_tcp_sender.py ...) and puts NORAXON_SDK_PATH
# on PYTHONPATH, exactly like the manual procedure.
# NORAXON_SDK_PATH='C:\Users\<user>\Desktop\Poli\TCC\repo_EMG_noraxon\noraxon-sdk'
#
# One variable per EMG channel, numbered from 1 without gaps, in the order the
# games should receive them. Paste each ID exactly as list_device_channels
# prints it, inside single quotes.
# NORAXON_CHANNEL_ID_1='line.noraxon_g3_XXXXX;type.input.analog.emg;device.noraxon.ultium.\?\usb#vid_16d0&pid_069e#XXXXXXXX#{a5dcbf10-6530-11d2-901f-00c04fb951ed};'
# NORAXON_CHANNEL_ID_2='line.noraxon_g3_YYYYY;type.input.analog.emg;device.noraxon.ultium.\?\usb#vid_16d0&pid_069e#XXXXXXXX#{a5dcbf10-6530-11d2-901f-00c04fb951ed};'
#
# Optional:
# NORAXON_USE_SETUP=true               # false = skip the hardware setup dialog
# NORAXON_STARTUP_TIMEOUT_SECONDS=180  # includes confirming the setup dialog
# NORAXON_UV_PATH=C:\Users\<user>\.local\bin\uv.exe   # only if uv is not on PATH

# USB auto-identification. Defaults already cover the known guide handlebar and
# common pulmonary boards. Set a more precise case-insensitive regular expression
# only if two connected USB devices have an ambiguous description in `usbipd list`.
# REHAB_GUIDAO_USB_MATCH=Guidao|Arduino.*(M0|Zero|Uno)
# REHAB_PULMONARY_USB_MATCH=Pulmonar|Respir|ESP32|CP210|CH340
